# Docker Compose development configuration.
# Replace every secret before using this configuration outside local development.
COMPOSE_PROJECT_NAME=continuum

POSTGRES_DB=continuum
POSTGRES_USER=continuum
POSTGRES_PASSWORD=continuum_dev_database
POSTGRES_PORT=5432

REDIS_PASSWORD=continuum_dev_redis
REDIS_PORT=6379

API_PORT=3001
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000

JWT_SECRET=continuum-local-api-signing-secret-change-me
NEXTAUTH_SECRET=continuum-local-web-session-secret-change-me
DEMO_USER_PASSWORD=ContinuumDemo123!
SHOW_DEMO_CREDENTIALS=true
